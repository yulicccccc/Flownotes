      "version": 1,
      "versionNonce": 15338,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793753568971,
      "link": null,
      "locked": false,
      "text": "例如没有正确决定应该排除哪些基因、采用什么检测阈值。",
      "customData": {
        "richHtml": "例如没有正确决定应该<span style=\"color:#ef4444\">排除</span>哪些基因、采用什么<span style=\"color:#ef4444\">检测阈值</span>。",
        "softWrapped": true,
        "preferredWidth": 193.2,
        "fontStyle": null
      },
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14.4,
      "containerId": null,
      "originalText": "例如没有正确决定应该排除哪些基因、采用什么检测阈值。",
      "lineHeight": 1.35
    },
    {
