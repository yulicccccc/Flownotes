      "updated": 1793753568971,
      "link": null,
      "locked": false,
      "text": "统计推理或混杂因素处理错误：Statistical or confound reasoning",
      "customData": {
        "richHtml": "统计推理或混杂因素处理错误：Statistical or confound reasoning",
        "softWrapped": true,
        "preferredWidth": 192.9,
        "fontStyle": null
      },
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13.5,
      "containerId": null,
      "originalText": "统计推理或混杂因素处理错误：Statistical or confound reasoning",
      "lineHeight": 1.35
    },
    {
      "id": "FTH6QzpZGjiKIfmGpnOt",
      "type": "text",
      "x": 701.9,
      "y": 1311.8,
      "width": 181.6,
      "height": 41.9,
      "angle": 0,
