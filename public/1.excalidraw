      "text": "合理平衡病例与对照组能够减少 batch confounding，但不代表批次差异会消失。",
      "customData": {
        "richHtml": "合理<span style=\"color:#ef4444\">平衡</span>病例与对照组能够减少 batch confounding，但不代表批次差异<span style=\"color:#ef4444\">会消失</span>。",
        "softWrapped": true,
        "preferredWidth": 375.1,
        "fontStyle": null
      },
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
