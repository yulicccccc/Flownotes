      "isDeleted": false,
      "boundElements": [],
      "updated": 1793753568971,
      "link": null,
      "locked": false,
      "text": "例如忽略测序深度差异、混杂因素或重复采样之间的关联。",
      "customData": {
        "richHtml": "例如忽略测序<span style=\"color:#ef4444\">深度差异</span>、混杂因素或<span style=\"color:#ef4444\">重复采样</span>之间的关联。",
        "softWrapped": true,
        "preferredWidth": 181.6,
        "fontStyle": null
      },
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14.4,
      "containerId": null,
      "originalText": "例如忽略测序深度差异、混杂因素或重复采样之间的关联。",
      "lineHeight": 1.35
    },
