      "boundElements": [],
      "updated": 1793753568971,
      "link": null,
      "locked": false,
      "text": "错误理解研究问题：Incorrect problem interpretation",
      "customData": {
        "richHtml": "错误理解<span style=\"color:#ef4444\">研究问题</span>：Incorrect problem interpretation",
        "softWrapped": true,
        "preferredWidth": 224.1,
        "fontStyle": null
      },
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13.5,
      "containerId": null,
      "originalText": "错误理解研究问题：Incorrect problem interpretation",
      "lineHeight": 1.35
    },
    {
      "id": "C8xpHO9Mg9cBI53lgRKE",
      "type": "text",
      "x": 466.0,
      "y": 1261.3,
      "width": 193.2,
      "height": 41.9,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
